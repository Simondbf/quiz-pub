# Copier ce fichier en .env.

# Mot de passe du site (8 caractères au moins). Le changer déconnecte tout le monde.
# Laissé vide : pas de mot de passe, le site est ouvert à quiconque connaît
# son adresse (et peut s'en servir pour télécharger et monter des vidéos).
MOT_DE_PASSE=

# Facultatif : taille maximale d'une vidéo envoyée depuis l'ordinateur, en Go.
# TAILLE_MAX_GO=4
