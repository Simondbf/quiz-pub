# Copier ce fichier en .env. Tout est facultatif.

# Mot de passe du quiz (8 caractères au moins). Le changer déconnecte tout le monde.
# Laissé vide : pas de mot de passe, le site est ouvert à quiconque connaît
# son adresse.
MOT_DE_PASSE=

# Mot de passe du site de téléchargement, à donner à qui s'en sert.
# Laissé vide : ouvert à quiconque connaît son adresse.
TELECHARGEMENT_MOT_DE_PASSE=

# Nombre de jours avant l'effacement automatique des fichiers téléchargés.
# CONSERVATION_JOURS=7

# Taille maximale d'une vidéo envoyée au quiz depuis l'ordinateur, en Go.
# TAILLE_MAX_GO=4
